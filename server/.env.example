# ---- Server ----
PORT=5000
# Comma-separated list of browser origins allowed to call the API (only needed
# if the client is NOT served through the Vite dev proxy).
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer (Render, Nginx, ...)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/invest-tracker

# ---- Auth ----
# REQUIRED. Must be 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Daily price updates ----
# Cron expression, evaluated in Asia/Kolkata (IST). Default: every day at 23:30 IST,
# after NSE/BSE close (15:30) and after most mutual-fund NAVs are published.
PRICE_UPDATE_CRON=30 23 * * *
# Set to false to disable the built-in scheduler (e.g. when running several API
# instances and driving `npm run update-prices` from an external cron instead).
ENABLE_SCHEDULER=true
# Indian domestic gold trades at a premium to the international price because of
# import duty. Used only to convert international gold (USD/oz) to INR/gram.
# Verify the current customs duty and adjust; set 0 for the raw international price.
GOLD_IMPORT_DUTY_PERCENT=6
